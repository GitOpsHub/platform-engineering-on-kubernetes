# syntax=docker/dockerfile:1.7
FROM golang:1.22 AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/{{ .name }} .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/{{ .name }} /app
USER 65532:65532
EXPOSE {{ .port }}
ENTRYPOINT ["/app"]
