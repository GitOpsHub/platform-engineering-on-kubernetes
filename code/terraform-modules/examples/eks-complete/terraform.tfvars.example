region             = "eu-west-1"
environment        = "dev"
cluster_name       = "platform-dev"
kubernetes_version = "1.34"

# Your office/VPN egress range. Leave empty for a private-only API endpoint.
api_allowed_cidrs = ["203.0.113.0/24"]

admin_principal_arns = [
  "arn:aws:iam::111122223333:role/PlatformAdmins",
]
