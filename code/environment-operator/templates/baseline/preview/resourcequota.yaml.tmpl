apiVersion: v1
kind: ResourceQuota
metadata:
  name: env-quota
  namespace: "{{ .Namespace }}"
  labels:
    platform.mycompany.io/tenant: "{{ .Tenant }}"
    platform.mycompany.io/environment: "{{ .Name }}"
    platform.mycompany.io/managed-by: environment-operator
  annotations:
    platform.mycompany.io/owner-uid: "{{ .OwnerUID }}"
spec:
  hard:
    requests.cpu: "1"
    limits.cpu: "2"
    requests.memory: 2Gi
    limits.memory: 4Gi
    pods: "10"
    persistentvolumeclaims: "2"
