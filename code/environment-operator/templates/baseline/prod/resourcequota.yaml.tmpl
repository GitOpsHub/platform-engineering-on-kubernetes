apiVersion: v1
kind: ResourceQuota
metadata:
  name: env-quota
  namespace: "{{ .Namespace }}"
  labels:
    platform.mycompany.io/tenant: "{{ .Tenant }}"
    platform.mycompany.io/environment: "{{ .Name }}"
    platform.mycompany.io/managed-by: environment-operator
  annotations:
    platform.mycompany.io/owner-uid: "{{ .OwnerUID }}"
spec:
  hard:
    requests.cpu: "8"
    limits.cpu: "16"
    requests.memory: 16Gi
    limits.memory: 32Gi
    pods: "100"
    persistentvolumeclaims: "25"
